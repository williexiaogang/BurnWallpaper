{
  "schema_version": 5,
  "kind": "prompt_scheme",
  "id": "concept",
  "name": "风景与背景",
  "description": "以一个视觉母题、一个环境和一个空间构成为主的无人物壁纸，适合纯背景、纹样和风景。",
  "aspect_ratio": "16:9",
  "style": {
    "mode": "external",
    "recommended": [
      "builtin_visual_styles/anime",
      "builtin_visual_styles/illustration",
      "builtin_visual_styles/graphic",
      "builtin_visual_styles/three_d",
      "builtin_visual_styles/cinematic"
    ]
  },
  "template": [
    {
      "text": {
        "en": "{MOTIF} {COMPOSITION}",
        "zh": "{MOTIF}，{COMPOSITION}"
      }
    },
    {
      "text": {
        "en": ", with {SCENE} as the setting",
        "zh": "，场景为{SCENE}"
      }
    },
    {
      "if": "DECORATION",
      "text": {
        "en": ", {DECORATION}",
        "zh": "，{DECORATION}"
      }
    },
    {
      "if": "ANGLE",
      "text": {
        "en": ", {ANGLE} view",
        "zh": "，{ANGLE}视角"
      }
    },
    {
      "if": "ATMOSPHERE",
      "text": {
        "en": ", {ATMOSPHERE}",
        "zh": "，{ATMOSPHERE}"
      }
    },
    {
      "text": {
        "en": ", {MOOD}",
        "zh": "，{MOOD}"
      },
      "if": "MOOD"
    },
    {
      "text": {
        "en": ", no characters, no human figures, no text",
        "zh": "，无角色、无人物、不含文字"
      }
    }
  ],
