{
  "schema_version": 4,
  "kind": "prompt_scheme",
  "id": "concept",
  "name": "风景与背景",
  "description": "以一个视觉母题、一个环境和一个空间构成为主的无人物壁纸，适合纯背景、纹样和风景。",
  "aspect_ratio": "16:9",
  "style": {
    "mode": "external",
    "recommended": [
      "builtin_visual_styles/anime",
      "builtin_visual_styles/illustration",
      "builtin_visual_styles/graphic",
      "builtin_visual_styles/three_d"
    ]
  },
  "template": [
    {
      "text": "{MOTIF} {COMPOSITION}",
      "text_zh": "{MOTIF}，{COMPOSITION}"
    },
    {
      "text": ", with {SCENE} as the setting",
      "text_zh": "，场景为{SCENE}"
    },
    {
      "if": "DECORATION",
      "text": ", {DECORATION}",
      "text_zh": "，{DECORATION}"
    },
    {
      "if": "ANGLE",
      "text": ", {ANGLE} view",
      "text_zh": "，{ANGLE}视角"
    },
    {
      "if": "ATMOSPHERE",
      "text": ", {ATMOSPHERE}",
      "text_zh": "，{ATMOSPHERE}"
    },
    {
      "text": ", {MOOD}",
      "text_zh": "，{MOOD}",
      "if": "MOOD"
    },
    {
      "text": ", no characters, no human figures, no text",
      "text_zh": "，无角色、无人物、不含文字"
    }
  ],
  "variables": {
