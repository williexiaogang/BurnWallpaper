{
  "schema_version": 5,
  "kind": "prompt_scheme",
  "id": "cozy_animals",
  "name": "治愈小动物",
  "description": "从吃东西、喝饮料、玩耍、睡觉和探索中抽取清楚可见的动作，搭配大眼、点眼或熟睡表情。",
  "aspect_ratio": "16:9",
  "style": {
    "mode": "external",
    "recommended": [
      "builtin_visual_styles/illustration",
      "builtin_visual_styles/three_d",
      "builtin_visual_styles/anime"
    ]
  },
  "template": [
    {
      "text": {
        "en": "{ANIMAL} with {FUR_COLOR}, {EYES}, soft rounded features and a gentle, endearing presence",
        "zh": "{ANIMAL}，{FUR_COLOR}，{EYES}，轮廓圆润，气质温柔可亲"
      }
    },
    {
      "text": {
        "en": ", {POSE}",
        "zh": "，{POSE}"
      }
    },
    {
      "text": {
        "en": ", {FRAMING}, {COMPOSITION}",
        "zh": "，{FRAMING}，{COMPOSITION}"
      }
    },
    {
      "if": "EYE_DETAIL",
      "text": {
        "en": ", {EYE_DETAIL}",
        "zh": "，{EYE_DETAIL}"
      }
    },
    {
      "text": {
        "en": ", with {SCENE} as the setting",
        "zh": "，场景为{SCENE}"
      }
    },
    {
      "if": "DECORATION",
      "text": {
        "en": ", {DECORATION}",
        "zh": "，{DECORATION}"
      }
    },
    {
      "text": {
        "en": ", no text or logos",
        "zh": "，不含文字或标志"
      }
    }
  ],
  "variables": {
    "ANIMAL": {
      "label": "小动物",
      "required": true,
      "options": [
