{
  "schema_version": 3,
  "kind": "style",
  "id": "illustration",
  "name": "插画与写实库",
  "english": "ILLUSTRATION_STYLES",
  "description": "半写实数字绘画、绘本书水粉与钢笔蚀刻画风",
  "is_builtin": true,
  "template": [
    {
      "text": "{ART_STYLE}, {MATERIAL}"
    },
    {
      "if": "BACKDROP",
      "text": ", {BACKDROP}"
    },
    {
      "if": "LIGHTING",
      "text": ", {LIGHTING}"
    },
    {
      "if": "LENS",
      "text": ", {LENS}"
    },
    {
      "if": "BRUSH",
      "text": ", {BRUSH}"
    },
    {
      "if": "FINISH",
      "text": ", {FINISH}"
    }
  ],
  "variables": {
    "ART_STYLE": {
      "label": "画风",
      "group": "style",
      "options": [
        {
          "value": "storybook gouache illustration",
          "label": "绘本水粉插画",
          "provides": [
            "storybook",
            "handpainted"
          ],
          "category": "illustration"
        },
        {
          "value": "pen-and-ink engraving illustration over gouache",
          "label": "钢笔蚀刻＋水粉",
          "provides": [
            "engraving",
            "ink",
            "handpainted"
          ],
          "category": "illustration"
        }
      ],
      "provider": true
    },
    "MATERIAL": {
      "label": "材质",
      "group": "style",
      "options": [
        {
          "value": "a clean even surface with no visible texture",
          "label": "干净均匀表面"
        },
        {
          "value": "smooth matte finish",
          "label": "柔哑光质感"
        },
        {
          "value": "visible brush strokes and gouache texture",
          "label": "笔触可见·水粉质地",
          "any_of": [
            "storybook",
            "handpainted",
            "painted"
          ]
        },
        {
          "value": "dense cross-hatching with rough paper grain",
          "label": "密集排线·粗纸纹",
          "any_of": [
            "engraving",
            "ink",
            "retro"
          ]
        },
        {
          "value": "thick impasto paint texture",
          "label": "厚涂油彩肌理",
          "any_of": [
            "painted",
            "handpainted",
            "storybook"
          ]
        },
        {
          "value": "a subtle paper grain texture with fine fiber detail",
          "label": "细纸纹颗粒",
          "any_of": [
            "minimal",
            "flat",
            "graphic",
            "screenprint",
            "storybook",
            "handpainted"
          ]
        }
      ]
    },
    "BRUSH": {
      "label": "笔触线条",
      "group": "style",
      "options": [
        {
          "value": "balanced linework",
          "label": "均衡线稿"
        },
        {
          "value": "loose sketchy linework",
          "label": "松散速写线条",
          "any_of": [
            "storybook",
            "handpainted",
            "retro"
          ]
        },
        {
          "value": "bold heavy black ink lines",
          "label": "粗重黑墨线",
          "any_of": [
            "manga",
            "ink",
            "sticker",
            "engraving"
          ]
        },
        {
          "value": "fine engraved hatching",
          "label": "细密蚀刻排线",
          "any_of": [
            "engraving",
            "retro"
          ]
        }
      ],
      "probability": 0.65
    },
    "FINISH": {
      "label": "完成度",
      "group": "style",
      "options": [
        {
          "value": "a polished high-detail finish",
          "label": "精致高细节"
        },
        {
          "value": "subtle film grain and vintage tone",
          "label": "细微颗粒·复古调",
          "any_of": [
            "retro",
            "engraving",
            "manga"
          ]
        }
      ],
      "probability": 0.6
    },
    "BACKDROP": {
      "label": "背景处理",
      "group": "style",
      "options": [
        {
          "value": "with swirling impasto paint strokes",
          "label": "浓彩漩涡厚涂",
          "any_of": [
            "painted",
            "handpainted",
            "storybook",
            "engraving"
          ]
        },
        {
          "value": "with layered manga panel collage and ink splatter",
          "label": "漫画格拼贴·墨点",
          "any_of": [
            "manga",
            "ink",
            "retro",
            "sticker",
            "graphic"
          ]
        },
        {
          "value": "with a cracked teal stone texture",
          "label": "龟裂青石纹理"
        },
        {
          "value": "with a deep-blue gradient washed over a textured paper surface",
          "label": "深海蓝渐变叠纸纹",
          "any_of": [
            "minimal",
            "flat",
            "graphic",
            "handpainted",
            "storybook",
            "screenprint"
          ]
        },
        {
          "value": "with a soft corner-to-corner tonal gradient in cool tones",
          "label": "冷调对角渐变",
          "any_of": [
            "minimal",
            "flat",
            "graphic",
            "screenprint",
            "storybook"
          ]
        }
      ],
      "probability": 0.4
    },
    "LIGHTING": {
      "label": "打光",
      "group": "style",
      "options": [
        {
          "value": "soft studio key light",
          "label": "柔和棚拍主光"
        },
        {
          "value": "warm practical lights in background",
          "label": "背景暖光",
          "any_of": [
            "cgi",
            "three_d",
            "soft",
            "realistic",
            "painted",
            "storybook"
          ]
        },
        {
          "value": "cool ambient with warm highlights",
          "label": "冷环境·暖高光"
        },
        {
          "value": "bright even daylight",
          "label": "明亮均匀日光"
        },
        {
          "value": "gentle side light with soft shadows",
          "label": "柔和侧光·毛发阴影细腻",
          "any_of": [
            "cgi",
            "three_d",
            "soft",
            "storybook",
            "handpainted",
            "minimal"
          ]
        },
        {
          "value": "soft front-left key light",
          "label": "左前柔主光",
          "any_of": [
            "cgi",
            "three_d",
            "soft",
            "storybook",
            "handpainted",
            "minimal",
            "flat"
          ]
        },
        {
          "value": "warm rim light tracing the subject edge",
          "label": "暖色轮廓光勾边",
          "any_of": [
            "cgi",
            "three_d",
            "soft",
            "painted",
            "realistic",
            "storybook"
          ]
        },
        {
          "value": "soft diffuse light falling from one corner",
          "label": "单角柔散光",
          "any_of": [
            "minimal",
            "flat",
            "graphic",
            "storybook",
            "handpainted",
            "cgi",
            "three_d",
            "soft"
          ]
        }
      ]
    },
    "LENS": {
      "label": "镜头",
      "group": "style",
      "options": [
        {
          "value": "deep focus with crisp detail throughout",
          "label": "深景深·全程清晰"
        }
      ],
      "probability": 0.55
    }
  },
  "tests": [
    {
      "name": "包内画风与材质可解析",
      "select": {
        "ART_STYLE": "storybook gouache illustration"
      },
      "expect": {
        "include": [
          "ART_STYLE",
          "MATERIAL"
        ]
      }
    }
  ],
  "randomize_variables": true,
  "supported_content_types": [
    "anthropomorphic",
    "human",
    "abstract"
  ]
}
