    {
      "if": "BACKDROP",
      "text": ", {BACKDROP}"
    },
    {
      "if": "LIGHTING",
      "text": ", {LIGHTING}"
    },
    {
      "if": "LENS",
      "text": ", {LENS}"
    },
    {
      "if": "BRUSH",
      "text": ", {BRUSH}"
