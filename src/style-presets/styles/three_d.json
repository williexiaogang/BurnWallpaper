{
  "schema_version": 3,
  "kind": "style",
  "id": "three_d",
  "name": "3D画风库",
  "english": "THREE_D_STYLES",
  "description": "柔和3D与动画电影CGI画风",
  "is_builtin": true,
  "template": [
    {
      "text": "{ART_STYLE}, {MATERIAL}"
    },
    {
      "if": "BACKDROP",
      "text": ", {BACKDROP}"
    },
    {
      "if": "LIGHTING",
      "text": ", {LIGHTING}"
    },
    {
      "if": "LENS",
      "text": ", {LENS}"
    },
    {
      "if": "BRUSH",
      "text": ", {BRUSH}"
    },
    {
      "if": "FINISH",
      "text": ", {FINISH}"
    }
  ],
  "variables": {
    "ART_STYLE": {
      "label": "画风",
      "group": "style",
      "options": [
        {
          "value": "semi-realistic digital painting",
          "label": "半写实数字绘画",
          "provides": [
            "painted",
            "realistic"
          ],
          "category": "three_d"
        },
        {
          "value": "soft 3D-rendered illustration",
          "label": "柔和3D渲染插画",
          "provides": [
            "three_d",
            "cgi"
          ],
          "category": "three_d"
        },
        {
          "value": "fluffy 3D animated-film CGI",
          "label": "3D动画电影质感",
          "provides": [
            "cgi",
            "three_d",
            "soft"
          ],
          "category": "three_d"
        }
      ],
      "provider": true
    },
    "MATERIAL": {
      "label": "材质",
      "group": "style",
      "options": [
        {
          "value": "a clean even surface with no visible texture",
          "label": "干净均匀表面"
        },
        {
          "value": "smooth matte finish",
          "label": "柔哑光质感"
        },
        {
          "value": "soft fuzzy fur shading with fine individual strands",
          "label": "绒毛·根根分明",
          "any_of": [
            "cgi",
            "three_d",
            "soft"
          ],
          "excludes": [
            "flat"
          ],
          "content_types": [
            "anthropomorphic"
          ]
        },
        {
          "value": "glossy eye shaders with subsurface scattering",
          "label": "眼球高光·次表面散射",
          "any_of": [
            "cgi",
            "three_d"
          ],
          "content_types": [
            "anthropomorphic",
            "human"
          ]
        },
        {
          "value": "visible brush strokes and gouache texture",
          "label": "笔触可见·水粉质地",
          "any_of": [
            "storybook",
            "handpainted",
            "painted"
          ]
        },
        {
          "value": "thick impasto paint texture",
          "label": "厚涂油彩肌理",
          "any_of": [
            "painted",
            "handpainted",
            "storybook"
          ]
        },
        {
          "value": "volumetric forms with refined shading",
          "label": "体积感·细腻明暗",
          "any_of": [
            "realistic",
            "three_d",
            "painted"
          ]
        }
      ]
    },
    "BRUSH": {
      "label": "笔触线条",
      "group": "style",
      "options": [
        {
          "value": "balanced linework",
          "label": "均衡线稿"
        },
        {
          "value": "no visible outlines",
          "label": "无描边",
          "any_of": [
            "cgi",
            "three_d",
            "minimal",
            "painted"
          ]
        }
      ],
      "probability": 0.65
    },
    "FINISH": {
      "label": "完成度",
      "group": "style",
      "options": [
        {
          "value": "a polished high-detail finish",
          "label": "精致高细节"
        },
        {
          "value": "cinematic shallow depth of field",
          "label": "电影感浅景深",
          "any_of": [
            "cgi",
            "three_d",
            "realistic"
          ]
        },
        {
          "value": "soft diffused studio glow",
          "label": "柔和棚拍光晕",
          "any_of": [
            "cgi",
            "soft",
            "commercial"
          ]
        },
        {
          "value": "high-contrast glossy highlights",
          "label": "高对比光泽高光",
          "any_of": [
            "cel",
            "commercial",
            "modern",
            "three_d"
          ]
        }
      ],
      "probability": 0.6
    },
    "BACKDROP": {
      "label": "背景处理",
      "group": "style",
      "options": [
        {
          "value": "with swirling impasto paint strokes",
          "label": "浓彩漩涡厚涂",
          "any_of": [
            "painted",
            "handpainted",
            "storybook",
            "engraving"
