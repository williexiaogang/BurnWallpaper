  "tests": [
    {
      "name": "包内画风与材质可解析",
      "select": {
        "ART_STYLE": "semi-realistic digital painting"
      },
      "expect": {
        "include": [
          "ART_STYLE",
          "MATERIAL"
        ]
      }
    }
