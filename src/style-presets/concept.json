{
  "schema_version": 2,
  "id": "concept",
  "name": "概念",
  "english": "CONCEPT",
  "description": "无主体壁纸：母题、场景、背景与画风自由组合，模板不含角色，专出纯背景／纹样／风景／概念图",
  "is_builtin": true,
  "template": [
    {
      "text": "A {ANGLE} view of {MOTIF}, {COMPOSITION}"
    },
    {
      "text": ", set in {SCENE}"
    },
    {
      "if": "BACKDROP",
      "text": ", {BACKDROP}"
    },
    {
      "if": "ATMOSPHERE",
      "text": ", {ATMOSPHERE}"
    },
    {
      "text": ", {LIGHTING}, {MOOD}"
    },
    {
      "if": "LENS",
      "text": ", {LENS}"
    },
    {
      "text": ", {ART_STYLE}, {MATERIAL}"
    },
    {
      "if": "BRUSH",
      "text": ", {BRUSH}"
    },
    {
      "if": "FINISH",
      "text": ", {FINISH}"
    },
    {
      "text": ", no characters, no human figures, no text"
    }
  ],
