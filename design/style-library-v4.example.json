          { "id": "manga", "label": "漫畫墨線", "value": "expressive inked manga illustration" }
        ] },
        "FINISH": { "label": "筆觸", "required": true, "options": [
          { "id": "cel", "label": "平塗", "value": "clean cel-shaded colors" },
          { "id": "painted", "label": "柔和繪製", "value": "softly painted shading" }
        ] }
      }
    },
    {
      "id": "watercolor",
      "name": "水彩",
      "description": "水彩紙與色彩暈染",
      "tags": ["style:watercolor"],
      "template": [{ "text": "{MEDIUM}, {FINISH}", "text_zh": "{MEDIUM}，{FINISH}" }],
      "variables": {
        "MEDIUM": { "label": "媒介", "required": true, "options": [
          { "id": "watercolor", "label": "透明水彩", "value": "transparent watercolor illustration" }
        ] },
        "FINISH": { "label": "筆觸", "required": true, "options": [
          { "id": "wash", "label": "暈染", "value": "delicate washes on textured paper" },
          { "id": "dry", "label": "乾筆", "value": "subtle dry-brush texture on paper" }
        ] }
      }
    },
    {
      "id": "graphic",
      "name": "平面海報",
      "description": "平面形狀與版印質感",
