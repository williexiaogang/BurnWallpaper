        "MEDIUM": { "label": "媒介", "required": true, "options": [
          { "id": "poster", "label": "平面海報", "value": "flat graphic poster illustration" }
        ] },
        "FINISH": { "label": "筆觸", "required": true, "options": [
          { "id": "screenprint", "label": "絲網印刷", "value": "screen-print texture and clean shapes" },
          { "id": "vector", "label": "幾何形狀", "value": "crisp geometric shapes and clean edges" }
        ] }
      }
